diff --git a/portable/build.sh b/portable/build.sh
new file mode 100755
--- /dev/null
+++ b/portable/build.sh
@@ -0,0 +1,9 @@
+#!/bin/sh
+set -eu
+cd "$(dirname "$0")/.."
+clang++ -std=c++17 -O2 -Wno-deprecated-declarations -Wno-format \
+  -Wno-shift-negative-value -Wno-tautological-constant-out-of-range-compare \
+  -include portable/compat.h -I. -IBinaryDecompiler -IBinaryDecompiler/include \
+  -IBinaryDecompiler/internal_includes HLSLDecompiler/DecompileHLSL.cpp \
+  BinaryDecompiler/decode.cpp BinaryDecompiler/reflect.cpp portable/main.cpp \
+  -o portable/hlsl-decompiler
diff --git a/portable/compat.h b/portable/compat.h
new file mode 100644
--- /dev/null
+++ b/portable/compat.h
@@ -0,0 +1,65 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <cmath>
+#include <string>
+#include <type_traits>
+#include <vector>
+#include <algorithm>
+#include <strings.h>
+
+// Windows secure CRT overloads, with explicit bounds for string scans.
+template<typename... Args> int sprintf_s(char* out,size_t size,const char* format,Args... args){return snprintf(out,size,format,args...);}
+template<size_t N,typename... Args> int sprintf_s(char (&out)[N],const char* format,Args... args){return snprintf(out,N,format,args...);}
+template<typename... Args> int _snprintf_s(char* out,size_t size,size_t count,const char* format,Args... args){return snprintf(out,std::min(size,count+1),format,args...);}
+inline int strcpy_s(char* out,size_t size,const char* input){if(strlen(input)>=size){if(size)*out=0;return 1;}memcpy(out,input,strlen(input)+1);return 0;}
+template<size_t N> int strcpy_s(char (&out)[N],const char* input){return strcpy_s(out,N,input);}
+inline int strcat_s(char* out,size_t size,const char* input){size_t length=strlen(out);if(length>=size)return 1;return strcpy_s(out+length,size-length,input);}
+template<size_t N> int strcat_s(char (&out)[N],const char* input){return strcat_s(out,N,input);}
+#define _stricmp strcasecmp
+#define _strnicmp strncasecmp
+#define _isnan std::isnan
+#define _finite std::isfinite
+
+struct ScanArgument{void* pointer;size_t capacity;bool isPointer;};
+template<typename T> ScanArgument scanArgument(T value){
+    if constexpr(std::is_pointer_v<T>)return{(void*)value,0,true};
+    else return{nullptr,(size_t)value,false};
+}
+template<typename... Args> int sscanf_s(const char* input,const char* format,Args... args){
+    std::array<ScanArgument,sizeof...(Args)> arguments={scanArgument(args)...};
+    std::array<void*,32> pointers={};size_t count=0,index=0;
+    std::string bounded;
+    for(size_t i=0;format[i];){
+        if(format[i]!='%'){bounded+=format[i++];continue;}
+        size_t start=i++;if(format[i]=='%'){bounded+="%%";i++;continue;}
+        bool suppressed=format[i]=='*';if(suppressed)i++;
+        size_t widthStart=i;while(format[i]>='0'&&format[i]<='9')i++;
+        bool hasWidth=i>widthStart;
+        while(format[i]&&strchr("hlLjztI",format[i]))i++;
+        char conversion=format[i++];
+        if(conversion=='['){if(format[i]=='^')i++;if(format[i]==']')i++;while(format[i]&&format[i]!=']')i++;if(format[i])i++;}
+        bool string=conversion=='s'||conversion=='c'||conversion=='[';
+        if(!suppressed){
+            if(index>=arguments.size()||!arguments[index].isPointer||count>=pointers.size())return EOF;
+            pointers[count++]=arguments[index++].pointer;
+        }
+        size_t capacity=0;
+        if(!suppressed&&string){
+            if(index>=arguments.size()||arguments[index].isPointer)return EOF;
+            capacity=arguments[index++].capacity;
+            if(capacity==0)return EOF;
+        }
+        if(string&&!suppressed&&!hasWidth&&conversion!='c'){
+            bounded.append(format+start,widthStart-start);
+            bounded+=std::to_string(capacity-1);
+            bounded.append(format+widthStart,i-widthStart);
+        }else bounded.append(format+start,i-start);
+    }
+    if(count>20)return EOF;
+    return sscanf(input,bounded.c_str(),pointers[0],pointers[1],pointers[2],pointers[3],pointers[4],pointers[5],pointers[6],pointers[7],pointers[8],pointers[9],pointers[10],pointers[11],pointers[12],pointers[13],pointers[14],pointers[15],pointers[16],pointers[17],pointers[18],pointers[19]);
+}
+
+inline int strncpy_s(char* out,size_t size,const char* input,size_t count){if(count>=size){if(size)*out=0;return 1;}size_t n=std::min(count,strlen(input));memcpy(out,input,n);out[n]=0;return 0;}
diff --git a/portable/main.cpp b/portable/main.cpp
new file mode 100644
--- /dev/null
+++ b/portable/main.cpp
@@ -0,0 +1,23 @@
+#include "HLSLDecompiler/DecompileHLSL.h"
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <cstdio>
+#include <vector>
+FILE* LogFile=stderr;
+bool gLogDebug=false;
+int main(int argc,char**argv){
+    if(argc!=4){fprintf(stderr,"usage: hlsl-decompiler DXBC REFLECTED_ASM OUTPUT_HLSL\n");return 2;}
+    std::ifstream bytefile(argv[1],std::ios::binary),asmfile(argv[2]);
+    if(!bytefile||!asmfile)return 3;
+    std::vector<char> bytes((std::istreambuf_iterator<char>(bytefile)),{});
+    std::string assembly((std::istreambuf_iterator<char>(asmfile)),{});
+    if(bytes.size()<32||memcmp(bytes.data(),"DXBC",4))return 4;
+    ParseParameters params{};params.bytecode=bytes.data();params.decompiled=assembly.c_str();params.decompiledSize=assembly.size();
+    params.StereoParamsReg=params.IniParamsReg=-1;
+    bool patched=false,error=false;std::string profile;
+    auto result=DecompileBinaryHLSL(params,patched,profile,error);
+    std::ofstream out(argv[3]);out<<result;
+    if(result.empty()||error)return 5;
+    fprintf(stderr,"%s\n",profile.c_str());return 0;
+}
