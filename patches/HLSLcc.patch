+        if ((index == 1 && eResDim == RESOURCE_DIMENSION_TEXTURE1DARRAY) ||
+            (index == 2 && (eResDim == RESOURCE_DIMENSION_TEXTURE2DARRAY ||
+                            eResDim == RESOURCE_DIMENSION_TEXTURE2DMSARRAY)))
         {
             bcatcstr(glsl, ".get_array_size()");
         }
@@ -943,8 +949,8 @@ void ToMetal::GetResInfoData(Instruction* psInst, int index, int destElem)
 
             if (index < 3)
             {
-                if (psInst->eResDim != RESOURCE_DIMENSION_TEXTURE2DMS &&
