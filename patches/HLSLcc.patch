+                    eResDim != RESOURCE_DIMENSION_TEXTURE2DMSARRAY)
                     glsl << TranslateOperand(&psInst->asOperands[1], TO_FLAG_INTEGER); //mip level
 
                 bcatcstr(glsl, ")");
