+++ b/tools/hlslcc/offline_glsl.cpp
@@ -0,0 +1,14 @@
+#include "hlslcc.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+class Refl : public HLSLccReflection {};
+int main(int argc,char**argv){
+ if(argc!=2)return 2;FILE*f=fopen(argv[1],"rb");if(!f)return 2;
+ fseek(f,0,SEEK_END);long n=ftell(f);fseek(f,0,SEEK_SET);std::vector<char>bytes(n);
+ if(fread(bytes.data(),1,n,f)!=(size_t)n)return 2;fclose(f);
+ GlExtensions ext={};GLSLCrossDependencyData deps;HLSLccSamplerPrecisionInfo precision;Refl refl;GLSLShader out;
+ unsigned flags=HLSLCC_FLAG_UNIFORM_BUFFER_OBJECT|HLSLCC_FLAG_UNIFORM_BUFFER_OBJECT_WITH_INSTANCE_NAME|HLSLCC_FLAG_TRANSLATE_MATRICES|HLSLCC_FLAG_REMOVE_UNUSED_GLOBALS|HLSLCC_FLAG_DISABLE_FASTMATH;
+ if(!TranslateHLSLFromMem(bytes.data(),flags,LANG_440,&ext,&deps,precision,refl,&out))return 1;
+ fputs(out.sourceCode.c_str(),stdout);return 0;
+}
diff --git a/tools/rewrap/clip_distance.py b/tools/rewrap/clip_distance.py
new file mode 100644
--- /dev/null
+++ b/tools/rewrap/clip_distance.py
@@ -0,0 +1,55 @@
+"""Restore every DXBC clip-distance component in HLSLcc's Metal epilogue.
+
+HLSLcc uses the width of SV_ClipDistance0 for every semantic. A scalar
+SV_ClipDistance0 followed by float4 SV_ClipDistance1 therefore loses y/z/w.
+The Windows output signature gives the authoritative component masks.
+"""
+import re
+import struct
+
+
+def output_components(dxbc):
+    count = struct.unpack_from('<I', dxbc, 28)[0]
+    for offset in struct.unpack_from('<' + 'I' * count, dxbc, 32):
+        tag = dxbc[offset:offset + 4]
+        if tag not in (b'OSGN', b'OSG5', b'OSG1'):
+            continue
+        length = struct.unpack_from('<I', dxbc, offset + 4)[0]
+        signature = dxbc[offset + 8:offset + 8 + length]
+        rows = struct.unpack_from('<I', signature)[0]
+        stride = 24 if tag == b'OSGN' else 28 if tag == b'OSG5' else 32
+        prefix = 0 if tag == b'OSGN' else 4
+        result = []
+        for row in range(rows):
+            base = 8 + row * stride + prefix
+            name_offset, semantic, system, scalar, register = struct.unpack_from('<5I', signature, base)
+            mask = signature[base + 20] & 15
+            if system == 2:
+                result.extend((semantic, component) for component in range(4) if mask & (1 << component))
+        return sorted(result)
+    return []
+
+
+def repair_clip_distances(msl, dxbc):
+    declaration = re.search(r'\bfloat\s+mtl_ClipDistance\s*\[\[\s*clip_distance\s*\]\]\s*(?:\[(\d+)\])?\s*;', msl)
+    if not declaration:
+        return msl
+    components = output_components(dxbc)
+    size = int(declaration[1] or 1)
+    if len(components) != size:
+        raise ValueError(f'Metal declares {size} clip distances, DXBC declares {len(components)}')
+    phases = set(re.findall(r'\bfloat4\s+phase(\d+)_ClipDistance\d+\s*;', msl))
+    if len(phases) != 1:
+        raise ValueError('Expected one vertex phase for clip-distance outputs')
+    phase = phases.pop()
+    assignments = []
+    for index, (semantic, component) in enumerate(components):
+        variable = f'phase{phase}_ClipDistance{semantic}'
+        if not re.search(r'\bfloat4\s+' + variable + r'\s*;', msl):
+            raise ValueError(f'Missing translated clip-distance temporary {variable}')
+        destination = f'output.mtl_ClipDistance[{index}]' if size > 1 else 'output.mtl_ClipDistance'
+        assignments.append(f'    {destination} = {variable}.{"xyzw"[component]};\n')
+    msl = re.sub(r'^[ \t]*output\.mtl_ClipDistance(?:\[\d+\])?\s*=[^;]*;[ \t]*\n', '', msl, flags=re.M)
+    if msl.count('return output;') != 1:
+        raise ValueError('Expected a single vertex return for clip-distance epilogue')
+    return msl.replace('    return output;', ''.join(assignments) + '    return output;')
