# Publish only the reviewed source directories.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements-dev.txt
!/tools/
!/converter/
!/patches/
!/shader-source/

/converter/*
!/converter/*.py
!/converter/*.swift
/patches/*
!/patches/*.patch
!/patches/dependencies.json
/shader-source/*
!/shader-source/Cage.hlsl

